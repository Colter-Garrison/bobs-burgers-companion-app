DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-string
PORT=3000
# Comma-separated list of origins allowed to call this API from a browser.
# Optional locally/in CI (falls back to a hardcoded dev default in
# app.ts). In production, set this to the real deployed frontend origin,
# e.g. CORS_ORIGINS=https://your-site.netlify.app
CORS_ORIGINS=http://localhost:8081,http://localhost:4173
# Optional. When all three are set, every request is logged and shipped
# to Grafana Cloud Loki (see server/src/lib/logger.ts). Left unset, logs
# just fall back to stdout — no Grafana account needed for local dev.
# Get these from your Grafana Cloud stack's Loki "Details" page (push
# URL + numeric user ID) and Security > Access Policies (API key).
GRAFANA_LOKI_HOST=https://logs-prod-XXX.grafana.net
GRAFANA_LOKI_USER_ID=123456
GRAFANA_LOKI_API_KEY=replace-with-your-grafana-cloud-api-key
# Optional. When unset, verification/recovery emails are logged to the
# console instead of sent (see server/src/lib/email.ts) — no Resend
# account needed for local dev/CI. Get a key from resend.com (free tier
# is comfortably enough for this app).
RESEND_API_KEY=replace-with-your-resend-api-key
# onboarding@resend.dev works out of the box for testing without a
# verified domain, but Resend restricts it to only sending to your own
# Resend account's email — switch to an address on a domain you've
# verified in Resend's dashboard (Domains > Add Domain, then add the DNS
# records it gives you) to actually send to real users.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
# The deployed frontend's own URL — used to build the links inside
# verification/recovery emails. Defaults to the local `expo start --web`
# dev server; set to the real Netlify URL in production. No trailing
# slash — one gets joined onto this to build each link (e.g. /verifyEmail),
# so a trailing slash here produces a double slash in the email's link.
WEB_APP_URL=http://localhost:8081
