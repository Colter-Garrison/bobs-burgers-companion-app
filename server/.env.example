DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-string
PORT=3000
# Comma-separated list of origins allowed to call this API from a browser.
# Optional locally/in CI (falls back to a hardcoded dev default in
# app.ts). In production, set this to the real deployed frontend origin,
# e.g. CORS_ORIGINS=https://your-site.netlify.app
CORS_ORIGINS=http://localhost:8081,http://localhost:4173
