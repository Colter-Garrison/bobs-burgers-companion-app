		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"bcrypt": "^5.1.1",
		"cors": "^2.8.6",
		"dotenv": "^16.4.5",
		"drizzle-orm": "^0.36.0",
		"express": "^4.21.0",
		"jsonwebtoken": "^9.0.2",
		"pg": "^8.13.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/cors": "^2.8.19",
		"@types/express": "^4.17.21",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/node": "^20.16.0",
		"@types/pg": "^8.11.10",
		"@types/supertest": "^6.0.3",
		"drizzle-kit": "^0.28.0",
		"supertest": "^7.2.2",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0",
		"vitest": "^4.1.10"
	}
